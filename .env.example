# Vidya-Vrtti Backend Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# MongoDB Connection String (Set in Render.com Dashboard or provide your Atlas URI)
# If left empty, server starts in standalone mode without crashing.
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vidya-vrtti?retryWrites=true&w=majority

# iLovePDF OCR API Configuration (Optional - for AI OCR verification)
# Register at: https://developer.ilovepdf.com/
ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_SECRET_KEY=
