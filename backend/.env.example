# ==============================================================================
# REQUIRED ENVIRONMENT VARIABLES (Set in Railway & local backend/.env)
# ==============================================================================

# 1. Google Gemini API Key (Free tier from https://aistudio.google.com/)
# Used for AI-powered structured field extraction (Name, DOB, Caste Category) from raw OCR text
GEMINI_API_KEY=your_gemini_api_key_here

# 2. MongoDB Atlas Database Connection String
# Get this from MongoDB Atlas -> Database -> Connect -> Connect your application
MONGO_URI=mongodb+srv://mainaudy12_db_user:fONwulbjlyOq1W8k@vidya-vritti-databse.bjidi2m.mongodb.net/vidya-vrtti?retryWrites=true&w=majority&appName=vidya-vritti-databse

# 3. Server Port (Railway sets PORT automatically; default is 5000)
PORT=5000

# 4. CORS Allowed Origins (Set to your Netlify URL or comma-separated list; * for all)
CORS_ORIGIN=*

# 5. JWT Secret Key for Session Authentication
JWT_SECRET=vidya_vrtti_jwt_secret_key_2026

# ==============================================================================
# OPTIONAL VARIABLES
# ==============================================================================
# iLovePDF API (Optional fallback OCR provider)
ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_SECRET_KEY=

